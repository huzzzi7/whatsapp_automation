# MySQL (Laragon / phpMyAdmin). Create database and import db.sql first.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp

# BullMQ / Redis — BullMQ recommends Redis 6.2+ (warnings if older). Prefer upgrading Redis.
# Set BULLMQ_SKIP_REDIS_VERSION_CHECK=true only if you accept Redis < 6.2 and want to silence BullMQ warnings.
# Windows: use Upstash (below), Memurai (Redis-compatible), or Docker redis:7 — not the legacy Redis 3–5 Windows port.
# Local dev (Redis/Memurai/Docker on 6379): redis://127.0.0.1:6379
# Upstash (no local install): copy REDIS_URL from Upstash Connect tab — must start with rediss:// (TLS).
# Using redis:// against Upstash causes ECONNRESET; port is usually 6380.
# Upstash: rediss://:YOUR_PASSWORD@YOUR_HOST.upstash.io:6380
REDIS_URL=redis://127.0.0.1:6379

# ── BullMQ / Redis ──
BULLMQ_SKIP_REDIS_VERSION_CHECK=false

# Message sending concurrency per campaign batch.
# Keep at 1 for sequential sending (anti-bot behavior).
# Increasing above 1 risks WhatsApp blocking.
SEND_FIRST_MESSAGE_CONCURRENCY=1

# ── Delay / Behavior Settings ──
CONVERSATION_STATE_USE_FILE=false
MESSAGE_DELAY_MIN_MS=10000
MESSAGE_DELAY_MAX_MS=60000
DISABLE_DELAYS=false
MESSAGE_COOLDOWN_MS=120000
REPLY_COOLDOWN_MS=120000

# Phase 4 — Green API Queue Control
# Soft threshold — delay individual job 30s when Green queue >= this value
GREEN_QUEUE_MAX=20
# Hard threshold — set Redis pause flag + delay 60s when Green queue >= this value
GREEN_QUEUE_HARD_MAX=40
# Max allowed waiting jobs in local BullMQ queue (Task 4.4)
LOCAL_QUEUE_MAX_WAITING=50
# Cache TTL for Green API queue depth check in ms
GREEN_QUEUE_CACHE_MS=5000

NODE_ENV=production
PORT=3000

# ── Logging ──
DEBUG_LOGS=false

SESSION_SECRET=your_secret_here
# Optional; default is connect.sid (Express default).
# SESSION_COOKIE_NAME=session_cookie_name
CORS_ORIGIN=https://yourdomain.com
DEFAULT_COUNTRY_CODE=92

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

TRUST_PROXY=true

# MySQL (Laragon / phpMyAdmin). Create database and import db.sql first.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp

NODE_ENV=production
PORT=3000



SESSION_SECRET=your_secret_here
# Optional; default is connect.sid (Express default).
# SESSION_COOKIE_NAME=session_cookie_name
CORS_ORIGIN=https://yourdomain.com
DEFAULT_COUNTRY_CODE=92

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

TRUST_PROXY=true

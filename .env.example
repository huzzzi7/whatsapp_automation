NODE_ENV=production
PORT=3000

# MySQL (Prisma). Encode special characters in password (URL-encode).
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict
# Hostinger: use the credentials from hPanel → Databases → MySQL.
DATABASE_URL="mysql://u845757058_botuniversity:Botuniversity%40live1@127.0.0.1:3306/u845757058_botuniversity?sslaccept=strict"
SESSION_SECRET=your_secret_here
CORS_ORIGIN=https://yourdomain.com
DEFAULT_COUNTRY_CODE=92

# Session cookie (HTTP dev: secure=false; HTTPS prod: secure=true)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Behind nginx / Hostinger reverse proxy (HTTPS termination)
TRUST_PROXY=true

# Cross-site SPA only (HTTPS required): SESSION_COOKIE_SAMESITE=none + SESSION_COOKIE_SECURE=true

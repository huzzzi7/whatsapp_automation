generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String   @default("")
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
}

model ConversationState {
  phone         String   @id
  lastSentIndex Int
  campaignId    String?
  sequence      String
  updatedAt     DateTime @updatedAt
}

model CampaignLog {
  id                  String   @id @default(cuid())
  clientCampaignId    String
  totalUsers          Int
  totalUniversities   Int
  universityStats     String
  createdAt           DateTime @default(now())
}

model GreenInstance {
  id               String   @id @default(cuid())
  name             String
  phoneNumber      String
  greenInstanceId  String
  apiToken         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

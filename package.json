{
  "name": "whatsapp-automation",
  "version": "1.0.0",
  "description": "WhatsApp 6-message sequence automation via GreenAPI, driven by Excel (original.xlsx)",
  "main": "server.js",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "prestart": "npm run build",
    "start": "node server.js",
    "dry-run": "node index.js --dry-run",
    "server": "node server.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "uuid": "8.3.2",
    "xlsx": "^0.18.5"
  }
}

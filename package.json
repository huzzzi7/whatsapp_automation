{
  "name": "whatsapp-automation",
  "version": "1.0.0",
  "description": "WhatsApp 6-message sequence automation via GreenAPI, driven by Excel (original.xlsx)",
  "main": "server.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "start": "node server.js",
    "dry-run": "node index.js --dry-run",
    "server": "node server.js",
    "create-admin": "node prisma/create-admin.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push && prisma generate",
    "db:push:node": "node src/dbSetup.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "prisma": "5.22.0",
    "xlsx": "^0.18.5"
  }
}
